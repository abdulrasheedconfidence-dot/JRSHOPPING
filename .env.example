# Copy to .env on the web server and add your Flutterwave secret key there.
# Never put a Flutterwave secret key in script.js or in the public website.
FLW_SECRET_KEY=replace-with-a-new-flutterwave-secret-key
FLW_WEBHOOK_SECRET_HASH=replace-with-a-random-webhook-secret-hash
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
INQUIRY_NOTIFICATION_EMAIL=jonathanroumie.officialchosen02@gmail.com
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Jonathan Roumie Shop <inquiries@your-verified-domain.com>
SHOP_CURRENCY=USD
SHIPPING_FEE=0
# Private admin dashboard. Use a unique password and a random session secret of at least 32 characters.
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
